





############################
# 🐍 PYTHON
############################
**/__pycache__/
*.py[cod]
*$py.class
# Virtual environments
env/
venv/
.venv/
**/env/
**/venv/
**/.venv/
# Build / distribution artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
############################
# 💻 VISUAL STUDIO CODE
############################
.vscode/
############################
# 🔒 SECRETS / ENV FILES
############################
.env
**/.env
.env.*
**/.env.*
!.env.example
############################
# 📝 LOCAL COMMIT MESSAGE DRAFTS & LOGS
############################
# Ignore all commit-* files everywhere in the repo,
# except those in docs/commit-examples/ and docs/commit-logs/
commit-*
**/commit-*
# Never ignore documentation commit logs or commit-examples
!docs/commit-examples/commit-*
!docs/commit-logs/
!docs/commit-logs/**

# Default .gitignore entries for Python projects
############################
# 🐍 PYTHON BYTECODE FILES
# Avoid tracking compiled Python artifacts
############################
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
############################
# 📦 VIRTUAL ENVIRONMENTS
# Don't include local virtualenvs (by name or location)
############################
env/
venv/
.venv/
ENV/
**/env/
**/venv/
**/.venv/
############################
# 🧪 TEST OUTPUT & COVERAGE
# Ignore test artifacts, reports, and caches
############################
*.log
*.coverage
.coverage
htmlcov/
.cache/
.tox/
.nox/
.pytest_cache/
############################
# 🏗️ BUILD / DISTRIBUTION FILES
# Python packaging outputs and build folders
############################
build/
dist/
*.egg
*.egg-info/
.eggs/
############################
# 💻 IDE / EDITOR SETTINGS
# Editor-specific configs that shouldn't be shared
############################
.vscode/
.idea/
*.swp
*.swo
############################
# 🔒 ENVIRONMENT VARIABLES / SECRETS
# Protect secrets and local environment configs
############################
.env
.env.*
**/.env
**/.env.*
!.env.example  # allow safe template files
############################
# 🐳 DOCKER / RUNTIME SOCKETS & PIDs
# Runtime process or socket files (useful for container setups)
############################
*.pid
*.sock
############################
# 📓 JUPYTER NOTEBOOK FILES
# Jupyter auto-saved checkpoint files
############################
.ipynb_checkpoints/
############################
# 🖥️ OS-SPECIFIC FILES
# Files generated by macOS and Windows
############################
.DS_Store
Thumbs.db
############################
# 📝 GIT COMMIT DRAFTS / CUSTOM LOGS
# Allow local commit drafts while excluding generated logs
############################
commit-*
**/commit-*
!docs/commit-examples/commit-*
!docs/commit-logs/
!docs/commit-logs/**
############################
# 🗂️ MISCELLANEOUS 
# Other common patterns that may be useful
# You can add your own here as needed
############################
